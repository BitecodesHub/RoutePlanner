# Copy to .env and fill in. Never commit real secrets.

# --- Database (PostgreSQL, e.g. Neon / Supabase / RDS) ---
# Pooled connection string used by the app at runtime.
# connect_timeout gives serverless (Neon) compute time to wake from cold start.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DB?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct (non-pooled) connection used for migrations/DDL. Same host without "-pooler".
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DB?sslmode=require&connect_timeout=15"

# --- Auth ---
# 32+ char secret used to sign session JWTs.
AUTH_SECRET="change-me-to-a-long-random-string"

# Public URL used in emails and share links.
APP_BASE_URL="http://localhost:3000"

# --- Email ---
# Resend HTTP API (preferred, works on serverless). Leave blank to fall back to SMTP.
RESEND_API_KEY=""
# Verified sender. Use "onboarding@resend.dev" until you verify a domain in Resend.
MAIL_FROM="RoutePilot <onboarding@resend.dev>"

# SMTP fallback (used only when RESEND_API_KEY is empty; logged when both unset).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"

# --- Seed bootstrap ---
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin@12345"

# --- External services ---
OSRM_BASE_URL="https://router.project-osrm.org"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
