# Local development environment. Never commit real secrets.
DATABASE_URL="file:./dev.db"

# 32+ char secret used to sign session JWTs. Replace in production.
AUTH_SECRET="dev-only-secret-change-me-0123456789abcdef"

# Base URL used in emails and share links.
APP_BASE_URL="http://localhost:3000"

# SMTP (optional — when unset, emails are logged instead of sent)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
MAIL_FROM="Route System <no-reply@example.com>"

# Initial admin bootstrap (used by prisma seed)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="Admin@12345"

# External services
OSRM_BASE_URL="https://router.project-osrm.org"
NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
